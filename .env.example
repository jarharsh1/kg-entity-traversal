# Copy to .env and adjust. All values have sensible defaults.
# NOTE: the traversal engine needs no model; these only affect optional prose
# phrasing of the already-structured answer.

# Ollama model server endpoint. In docker-compose this is http://ollama:11434.
OLLAMA_HOST=http://localhost:11434

# Model used ONLY to phrase results as prose (`ollama pull llama3.2`).
KG_LLM_MODEL=llama3.2

# Set to 1 to force deterministic offline phrasing (no Ollama needed).
KG_OFFLINE=0

# Path to the structured records loaded at startup.
KG_DATA=data/clinical.json
